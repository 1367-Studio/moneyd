# Free key from https://finnhub.io/register
FINNHUB_API_KEY=

# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot IDs (create these in AdSense → Ads → By ad unit)
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_INFEED=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
